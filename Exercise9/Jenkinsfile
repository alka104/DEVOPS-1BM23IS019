
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('Exercise9') {
                    echo 'Installing Python dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise9') {
                    echo 'Running unit tests...'
                    sh '.venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercise9') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p python-app-deploy
                        cp app.py python-app-deploy/
                        cp requirements.txt python-app-deploy/
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('Exercise9') {
                    echo 'Starting Flask application...'
                    sh '''
                        if [ -f python-app-deploy/app.pid ]; then
                            kill "$(cat python-app-deploy/app.pid)" 2>/dev/null || true
                            rm -f python-app-deploy/app.pid
                        fi

                        nohup .venv/bin/python python-app-deploy/app.py \
                            > python-app-deploy/app.log 2>&1 &
                        echo $! > python-app-deploy/app.pid

                        for i in $(seq 1 20); do
                            if curl -fsS http://127.0.0.1:5000/; then
                                echo
                                echo "Application started successfully."
                                exit 0
                            fi
                            sleep 1
                        done

                        echo "Application failed to start."
                        cat python-app-deploy/app.log
                        exit 1
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('Exercise9') {
                    echo 'Testing the deployed application...'
                    sh '''
                        .venv/bin/python -m unittest discover -s .
                        curl -fsS http://127.0.0.1:5000/
                        echo
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
